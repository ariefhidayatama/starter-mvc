import { Link, router, usePage } from '@inertiajs/react';
import { createColumnHelper } from '@tanstack/react-table';
import { Inbox, ListPlus, Pencil, Rows3, Trash2 } from 'lucide-react';
import {{ model }}Controller from '@/actions/App/Http/Controllers/Admin/{{ model }}Controller';
import type { {{ model }} } from '@/components/admin/{{ formFile }}';
import {
    DataTable,
    dataTableFeatures,
} from '@/components/data-table/data-table';
import { EmptyState } from '@/components/empty-state';
import { Pagination } from '@/components/pagination';
import { RowActions } from '@/components/row-actions';
import type { RowAction } from '@/components/row-actions';
{{ statusBadgeImport }}import { Button } from '@/components/ui/button';
import {
    Card,
    CardDescription,
    CardHeader,
    CardTitle,
} from '@/components/ui/card';
import { routeKey } from '@/lib/route-key';
import type { RouteKey } from '@/lib/route-key';
import type { Paginated } from '@/types';

/*
 * "{{ detailTitle }}" section on the {{ parentSingular }} edit page (master–detail).
 * Generated by the CRUD generator — edit freely.
 */

/** Row actions; managing {{ detailTitleLower }} follows the parent's "update" ability. */
function RowMenu({
    item,
    parentKey,
}: {
    item: {{ model }};
    parentKey: RouteKey;
}) {
    const { abilities } = usePage<{ abilities: { update: boolean } }>().props;

    if (!abilities.update) {
        return null;
    }

    const route = { {{ parentParameter }}: parentKey, {{ detailParam }}: routeKey(item) };
    const actions: RowAction[] = [
        {
            type: 'link',
            label: 'Edit',
            icon: Pencil,
            href: {{ model }}Controller.edit(route),
        },
        {
            type: 'confirm',
            label: 'Delete',
            icon: Trash2,
            destructive: true,
            confirm: {
                title: `Delete {{ detailSingular }} #${item.id}?`,
                description:
                    'This row will be permanently deleted. This action cannot be undone.',
                confirmLabel: 'Delete',
            },
            onConfirm: (close) =>
                router.visit({{ model }}Controller.destroy(route), {
                    preserveScroll: true,
                    onFinish: close,
                }),
        },
    ];

    return (
        <RowActions label={`Actions for {{ detailSingular }} #${item.id}`} actions={actions} />
    );
}

const column = createColumnHelper<typeof dataTableFeatures, {{ model }}>();

/** Columns need the parent's route key (ulid or id) for the row actions. */
const makeColumns = (parentKey: RouteKey) =>
    column.columns([
        column.display({
            id: 'actions',
            header: () => <span className="sr-only">Actions</span>,
            cell: ({ row }) => (
                <RowMenu item={row.original} parentKey={parentKey} />
            ),
        }),
{{ columns }}
    ]);

export function {{ model }}Section({
    parentKey,
    details,
    canManage,
}: {
    /** The parent's ulid (or id when its table has no ulid column). */
    parentKey: RouteKey;
    details: Paginated<{{ model }}>;
    canManage: boolean;
}) {
    const columns = makeColumns(parentKey);

    return (
        <Card className="max-w-full gap-0 overflow-hidden py-0">
            <CardHeader className="flex-row items-center gap-3 border-b py-4">
                <div className="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                    <Rows3 className="size-4.5" />
                </div>
                <div className="flex-1 space-y-1">
                    <CardTitle>{{ detailTitle }}</CardTitle>
                    <CardDescription>
                        {details.total} row{details.total === 1 ? '' : 's'} in{' '}
                        <code>{{ dbTable }}</code>.
                    </CardDescription>
                </div>
                {canManage && (
                    <Button asChild size="sm" className="shadow-sm shadow-primary/30">
                        <Link href={{{ model }}Controller.create(parentKey)}>
                            <ListPlus /> Add {{ detailSingular }}
                        </Link>
                    </Button>
                )}
            </CardHeader>

            <DataTable
                columns={columns}
                data={details.data}
                getRowId={(item) => String(item.id)}
                columnClassNames={{ actions: 'w-12 pr-0' }}
                empty={
                    <EmptyState
                        icon={Inbox}
                        title="No {{ detailTitleLower }} yet"
                        description="Add the first row to get started."
                    />
                }
            />

            {details.last_page > 1 && (
                <div className="border-t bg-muted/20 px-4 py-3">
                    <Pagination page={details} />
                </div>
            )}
        </Card>
    );
}
