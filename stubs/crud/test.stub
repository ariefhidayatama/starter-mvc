it('{{ table }}: tambah, ubah & hapus', function () {
    $payload = Arr::only({{ model }}::factory()->make()->toArray(), $this->fields);

    $this->actingAs($this->admin)->post('{{ url }}', $payload)->assertRedirect('{{ url }}');

    $item = {{ model }}::query()->latest('id')->firstOrFail();

    $this->actingAs($this->admin)
        ->get("{{ url }}/{$item->getRouteKey()}/edit")
        ->assertInertia(fn (Assert $page) => $page
            ->component('admin/{{ slug }}/edit')
            ->where('item.id', $item->id));

    $changes = Arr::only({{ model }}::factory()->make()->toArray(), $this->fields);

    $this->actingAs($this->admin)->put("{{ url }}/{$item->getRouteKey()}", $changes)->assertRedirect('{{ url }}');
    $this->actingAs($this->admin)->delete("{{ url }}/{$item->getRouteKey()}")->assertRedirect('{{ url }}');

    expect({{ model }}::find($item->id))->toBeNull();
