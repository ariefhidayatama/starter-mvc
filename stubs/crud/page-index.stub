import { Head, Link, router, usePage } from '@inertiajs/react';
import { createColumnHelper } from '@tanstack/react-table';
import { Inbox, Pencil, Plus, {{ searchIcon }}Table2, Trash2 } from 'lucide-react';
import {{ model }}Controller from '@/actions/App/Http/Controllers/Admin/{{ model }}Controller';
import type { {{ model }} } from '@/components/admin/{{ formFile }}';
import {
    DataTable,
    dataTableFeatures,
} from '@/components/data-table/data-table';
import { EmptyState } from '@/components/empty-state';
import { PageHeader } from '@/components/page-header';
import { Pagination } from '@/components/pagination';
import { RowActions } from '@/components/row-actions';
import type { RowAction } from '@/components/row-actions';
{{ statusBadgeImport }}import { Button } from '@/components/ui/button';
import { Card } from '@/components/ui/card';
{{ inputImport }}import { useTableQuery } from '@/hooks/use-table-query';
import { routeKey } from '@/lib/route-key';
import type { Paginated } from '@/types';

/*
 * {{ plural }}: list page. Generated by the CRUD generator — edit freely.
 */

type Filters = { search: string; sort: string; per_page: number };

/** What the user may do: app permission AND the database account's rights. */
type Abilities = { create: boolean; update: boolean; delete: boolean };

/** Row actions as a component, so it can read page props (usePage). */
function RowMenu({ item }: { item: {{ model }} }) {
    const { abilities } = usePage<{ abilities: Abilities }>().props;
    const actions: RowAction[] = [];

    if (abilities.update) {
        actions.push({
            type: 'link',
            label: 'Edit',
            icon: Pencil,
            href: {{ model }}Controller.edit(routeKey(item)),
        });
    }

    if (abilities.delete) {
        actions.push({
            type: 'confirm',
            label: 'Delete',
            icon: Trash2,
            destructive: true,
            confirm: {
                title: `Delete ${{{ titleExpr }}}?`,
                description:
                    'This {{ singular }} will be permanently deleted. This action cannot be undone.',
                confirmLabel: 'Delete',
            },
            onConfirm: (close) =>
                router.visit({{ model }}Controller.destroy(routeKey(item)), {
                    preserveScroll: true,
                    onFinish: close,
                }),
        });
    }

    return (
        <RowActions label={`Actions for ${{{ titleExpr }}}`} actions={actions} />
    );
}

/** Sortable column ids must match SORTS in {{ model }}Controller. */
const column = createColumnHelper<typeof dataTableFeatures, {{ model }}>();

const columns = column.columns([
    column.display({
        id: 'actions',
        header: () => <span className="sr-only">Actions</span>,
        cell: ({ row }) => <RowMenu item={row.original} />,
    }),
{{ columns }}
]);

export default function {{ model }}Index({
    items,
    filters,
    abilities,
}: {
    items: Paginated<{{ model }}>;
    filters: Filters;
    abilities: Abilities;
}) {
    const { {{ tableQueryVars }} } = useTableQuery(
        {{ model }}Controller.index.url(),
        filters,
        ['items', 'filters'],
    );

    return (
        <>
            <Head title="{{ plural }}" />

            <div className="space-y-6 p-4 md:p-6">
                <PageHeader
                    icon={Table2}
                    title="{{ plural }}"
                    description="Manage {{ pluralLower }}."
                />

                <Card className="gap-0 overflow-hidden py-0">
                    {/* Toolbar: [Add] [Search] */}
                    <div className="flex flex-col gap-2 border-b p-4 sm:flex-row sm:items-center">
                        {abilities.create && (
                            <Button
                                asChild
                                className="shrink-0 shadow-sm shadow-primary/30"
                            >
                                <Link href={{{ model }}Controller.create()}>
                                    <Plus /> Add {{ singular }}
                                </Link>
                            </Button>
                        )}
{{ searchBox }}
                    </div>

                    <DataTable
                        columns={columns}
                        data={items.data}
                        getRowId={(item) => String(item.id)}
                        sort={filters.sort}
                        onSortChange={(sort) => apply({ sort })}
                        columnClassNames={{ actions: 'w-12 pr-0' }}
                        empty={
                            <EmptyState
                                icon={Inbox}
                                title="No {{ pluralLower }} found"
                                description={{{ emptyDescription }}}
                            />
                        }
                    />

                    <div className="border-t bg-muted/20 px-4 py-3">
                        <Pagination
                            page={items}
                            onPerPageChange={(perPage) =>
                                apply({ per_page: perPage })
                            }
                        />
                    </div>
                </Card>
            </div>
        </>
    );
}

{{ model }}Index.layout = {
    breadcrumbs: [{ title: '{{ plural }}', href: {{ model }}Controller.index() }],
};
