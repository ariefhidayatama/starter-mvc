    public function index(Request $request): Response
    {
        Gate::authorize('viewAny', {{ model }}::class);

        $filters = $request->validate([
            'search' => ['nullable', 'string', 'max:100'],
            'sort' => ['nullable', Rule::in(QuerySort::options(array_keys(self::SORTS)))],
            'per_page' => ['nullable', 'integer', Rule::in([10, 25, 50, 100])],
        ]);

        $search = is_string($filters['search'] ?? null) ? trim($filters['search']) : '';
        $sort = is_string($filters['sort'] ?? null) ? $filters['sort'] : '{{ defaultSort }}';
        $perPage = is_numeric($filters['per_page'] ?? null) ? (int) $filters['per_page'] : 10;

{{ query }}

        return Inertia::render('admin/{{ slug }}/index', [
            'items' => QuerySort::apply($query, $sort, self::SORTS, '{{ defaultSort }}')
                ->paginate($perPage)
                ->withQueryString(),
            'filters' => ['search' => $search, 'sort' => $sort, 'per_page' => $perPage],
            'abilities' => $this->abilities(),
        ]);
    }

