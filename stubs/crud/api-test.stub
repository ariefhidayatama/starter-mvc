it('{{ table }} API: daftar, detail, tambah, ubah & hapus', function () {
    Sanctum::actingAs($this->admin);

    $this->postJson('{{ apiUrl }}', Arr::only({{ model }}::factory()->make()->toArray(), $this->fields))
        ->assertCreated()
        ->assertJsonPath('success', true);

    $item = {{ model }}::query()->latest('id')->firstOrFail();
    $key = $item->getRouteKey();

    $this->getJson('{{ apiUrl }}')
        ->assertOk()
        ->assertJsonPath('meta.total', 1)
        ->assertJsonStructure(['success', 'message', 'data', 'meta', 'links']);
    $this->getJson("{{ apiUrl }}/{$key}")->assertOk()->assertJsonPath('data.id', $item->id);

    $this->putJson("{{ apiUrl }}/{$key}", Arr::only({{ model }}::factory()->make()->toArray(), $this->fields))->assertOk();
    $this->deleteJson("{{ apiUrl }}/{$key}")->assertNoContent();

    expect({{ model }}::find($item->id))->toBeNull();
}){{ crudTestSkip }};
