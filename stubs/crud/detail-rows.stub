import { ListPlus, Rows3, Trash2 } from 'lucide-react';
import { useRef, useState } from 'react';
import InputError from '@/components/input-error';
import { Button } from '@/components/ui/button';
import {
    Card,
    CardDescription,
    CardHeader,
    CardTitle,
} from '@/components/ui/card';
import { Input } from '@/components/ui/input';
import {
    Table,
    TableBody,
    TableCell,
    TableHead,
    TableHeader,
    TableRow,
} from '@/components/ui/table';

/*
 * "{{ detailTitle }}" rows on the "Add {{ parentSingular }}" form (master–detail).
 * The {{ parentSingular }} and every row are sent at once and saved in ONE
 * transaction ({{ parentModel }}Controller@store): all rows or nothing.
 * Generated by the CRUD generator — edit freely.
 *
 * Inputs are uncontrolled: <Form> reads them from the DOM through nested
 * names ({{ detailInputKey }}[0][column]). Each row keeps a stable React key, so
 * removing a row in the middle never shifts the values of the other rows.
 */

/** Input key in the request (Save{{ parentModel }}Request) and in `errors`. */
const KEY = '{{ detailInputKey }}';

type Column = {
    name: string;
    label: string;
    type: 'string' | 'text' | 'integer' | 'decimal' | 'boolean' | 'date' | 'datetime' | 'select';
    required?: boolean;
    maxLength?: number;
    min?: number;
    options?: string[];
};

/** Same columns & limits as Save{{ model }}Request::fieldRules(). */
const COLUMNS: Column[] = [
{{ rowColumns }}
];

const SELECT_CLASS =
    'h-9 w-full rounded-md border border-input bg-transparent px-3 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 dark:bg-input/30';

function Cell({ column, name, label }: { column: Column; name: string; label: string }) {
    switch (column.type) {
        case 'boolean':
            return (
                <span className="flex h-9 items-center">
                    {/* Unchecked boxes are not sent; the hidden "0" is sent instead. */}
                    <input type="hidden" name={name} value="0" />
                    <input
                        type="checkbox"
                        name={name}
                        value="1"
                        aria-label={label}
                        className="size-4 accent-primary"
                    />
                </span>
            );
        case 'select':
            return (
                <select
                    name={name}
                    aria-label={label}
                    required={column.required}
                    defaultValue=""
                    className={SELECT_CLASS}
                >
                    <option value="">{column.required ? 'Choose…' : 'None'}</option>
                    {column.options?.map((option) => (
                        <option key={option} value={option}>
                            {option}
                        </option>
                    ))}
                </select>
            );
        default:
            return (
                <Input
                    name={name}
                    aria-label={label}
                    required={column.required}
                    className="h-9"
                    {...(column.type === 'integer' || column.type === 'decimal'
                        ? {
                              type: 'number',
                              inputMode: column.type === 'integer' ? 'numeric' : 'decimal',
                              step: column.type === 'integer' ? '1' : '0.01',
                              min: column.min,
                          }
                        : column.type === 'date'
                          ? { type: 'date' }
                          : column.type === 'datetime'
                            ? { type: 'datetime-local' }
                            : { maxLength: column.maxLength })}
                />
            );
    }
}

export function {{ model }}Rows({
    errors,
    max,
}: {
    /** `errors` from <Form>; row errors use keys like "{{ detailInputKey }}.0.column". */
    errors: Partial<Record<string, string>>;
    max: number;
}) {
    const nextKey = useRef(0);
    const [rows, setRows] = useState<number[]>([]);
    const tableRef = useRef<HTMLDivElement>(null);

    const addRow = () => {
        const key = nextKey.current++;
        setRows((current) => [...current, key]);
        // Focus the first cell of the new row once it is rendered.
        requestAnimationFrame(() =>
            tableRef.current
                ?.querySelector<HTMLElement>(`[data-row="${key}"] input:not([type=hidden]), [data-row="${key}"] select`)
                ?.focus(),
        );
    };

    const removeRow = (key: number) =>
        setRows((current) => current.filter((k) => k !== key));

    return (
        <Card className="max-w-full gap-0 overflow-hidden py-0">
            <CardHeader className="flex-row items-center gap-3 border-b py-4">
                <div className="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                    <Rows3 className="size-4.5" />
                </div>
                <div className="flex-1 space-y-1">
                    <CardTitle>{{ detailTitle }}</CardTitle>
                    <CardDescription>
                        {rows.length} of max {max} row{max === 1 ? '' : 's'} in{' '}
                        <code>{{ dbTable }}</code>. Saved together with the{' '}
                        {{ parentSingular }}: all rows or nothing.
                    </CardDescription>
                </div>
                <Button
                    type="button"
                    size="sm"
                    variant="outline"
                    onClick={addRow}
                    disabled={rows.length >= max}
                >
                    <ListPlus /> Add row
                </Button>
            </CardHeader>

            {errors[KEY] && (
                <div className="border-b px-4 py-3">
                    <InputError message={errors[KEY]} />
                </div>
            )}

            {rows.length === 0 ? (
                <p className="px-4 py-8 text-center text-sm text-muted-foreground">
                    No rows yet. Use “Add row”, or save the {{ parentSingular }} without{' '}
                    {{ detailTitleLower }}.
                </p>
            ) : (
                <div ref={tableRef}>
                    <Table>
                        <TableHeader>
                            <TableRow>
                                <TableHead className="w-12 pr-0 text-right">#</TableHead>
                                {COLUMNS.map((column) => (
                                    <TableHead key={column.name} className="min-w-32">
                                        {column.label}
                                        {column.required && (
                                            <span className="text-destructive" aria-hidden>
                                                {' '}
                                                *
                                            </span>
                                        )}
                                    </TableHead>
                                ))}
                                <TableHead className="w-12">
                                    <span className="sr-only">Remove</span>
                                </TableHead>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            {rows.map((key, index) => (
                                <TableRow
                                    key={key}
                                    data-row={key}
                                    className="hover:bg-transparent"
                                >
                                    <TableCell className="pr-0 text-right align-top text-muted-foreground tabular-nums">
                                        <span className="inline-flex h-9 items-center">
                                            {index + 1}
                                        </span>
                                    </TableCell>
                                    {COLUMNS.map((column) => (
                                        <TableCell
                                            key={column.name}
                                            className="px-2 align-top whitespace-normal"
                                        >
                                            <div className="grid gap-1">
                                                <Cell
                                                    column={column}
                                                    name={`${KEY}[${index}][${column.name}]`}
                                                    label={`Row ${index + 1} ${column.label}`}
                                                />
                                                <InputError
                                                    message={errors[`${KEY}.${index}.${column.name}`]}
                                                    className="text-xs"
                                                />
                                            </div>
                                        </TableCell>
                                    ))}
                                    <TableCell className="px-2 align-top">
                                        <Button
                                            type="button"
                                            variant="ghost"
                                            size="icon"
                                            className="text-muted-foreground hover:text-destructive"
                                            onClick={() => removeRow(key)}
                                            aria-label={`Remove row ${index + 1}`}
                                        >
                                            <Trash2 />
                                        </Button>
                                    </TableCell>
                                </TableRow>
                            ))}
                        </TableBody>
                    </Table>
                </div>
            )}
        </Card>
    );
}
