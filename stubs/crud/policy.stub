<?php

namespace App\Policies;

use App\Enums\PermissionName;
use App\Models\{{ model }};
use App\Models\User;
{{ policyImports }}
/**
 * Setiap aksi = satu permission ({{ table }}.view / create / update / delete).
 * Atur siapa yang boleh di halaman Permissions. Dibuat oleh CRUD generator.{{ policyNote }}
 */
class {{ model }}Policy
{
    public function viewAny(User $actor): bool
    {
        return $actor->can(PermissionName::{{ enum }}View){{ dbView }};
    }

    public function view(User $actor, {{ model }} ${{ variable }}): bool
    {
        return $actor->can(PermissionName::{{ enum }}View){{ dbView }};
    }

    public function create(User $actor): bool
    {
        return $actor->can(PermissionName::{{ enum }}Create){{ dbCreate }};
    }

    public function update(User $actor, {{ model }} ${{ variable }}): bool
    {
        return $actor->can(PermissionName::{{ enum }}Update){{ dbUpdate }};
    }

    public function delete(User $actor, {{ model }} ${{ variable }}): bool
    {
        return $actor->can(PermissionName::{{ enum }}Delete){{ dbDelete }};
    }
}
