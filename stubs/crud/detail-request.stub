use Illuminate\Foundation\Http\FormRequest;

/**
 * Tambah & ubah baris {{ detailSingular }} milik {{ parentSingular }}. Boleh bila user
 * boleh mengubah induknya. Dibuat oleh CRUD generator.
 */
class Save{{ model }}Request extends FormRequest
{
    public function authorize(): bool
    {
        ${{ parentVariable }} = $this->route('{{ parentParameter }}');

        return ${{ parentVariable }} instanceof {{ parentModel }}
            && (bool) $this->user()?->can('update', ${{ parentVariable }});
    }

    /**
     * @return array<string, list<mixed>>
     */
